# Copy to .env and edit. NEVER commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DB_NAME empty to use SQLite locally. Fill all DB_* to use PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Email: console backend prints emails in the terminal (safe for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Showroom <no-reply@example.com>
SITE_URL=http://127.0.0.1:8000
# Password for the demo admin created by `python manage.py seed_demo`
SEED_ADMIN_PASSWORD=ChangeMe123!
